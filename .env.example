# Copy this file to .env and fill in the values for the provider you want.
# Switching vendors is a configuration change, not a code change.

# --- Claude (Anthropic) ---
QA_MODEL_PROVIDER=anthropic
QA_MODEL=claude-sonnet-5-5
QA_MODEL_API_KEY=

# --- OpenAI ---
# QA_MODEL_PROVIDER=openai
# QA_MODEL=your-openai-model-name
# QA_MODEL_API_KEY=

# --- Gemini, through Google's OpenAI-compatible endpoint ---
# The free tier has low daily limits, and Google may use free-tier prompts to improve its
# products. Fine for this repo's invented data; use a paid tier for your company's data.
# QA_MODEL_PROVIDER=openai
# QA_MODEL=gemini-3.8-flash
# QA_MODEL_API_KEY=
# QA_MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Any OpenAI-compatible endpoint (other providers, or a local runtime such as Ollama) ---
# QA_MODEL_PROVIDER=openai
# QA_MODEL=llama3.1
# QA_MODEL_BASE_URL=http://localhost:11434/v1

# --- Temporary API errors (429 rate limit, 503 busy model) are retried with backoff ---
# QA_MODEL_MAX_RETRIES=4

# --- The crew (Chapter 9) ---
# A different model for one role, same provider and key. For example, a stronger Analyst:
# QA_ANALYST_MODEL=
# QA_DESIGNER_MODEL=
# QA_EXECUTOR_MODEL=
# QA_TRIAGER_MODEL=
# QA_REVIEWER_MODEL=        (Chapter 10: a different model family than the Executor catches different mistakes)
# Token budget for a whole crew run (default 400000).
# QA_CREW_MAX_TOKENS=400000
# The name recorded when you approve a gate (default: your user name).
# QA_REVIEWER=

# --- No API key: run the scripted demo ---
# QA_MODEL_PROVIDER=mock

# Where the booking app is running
BOOKING_URL=http://localhost:3000

# --- qa-tools MCP server (Chapter 3) ---
# Register the tools that change data (create/cancel bookings, reset). Off by default.
# QA_TOOLS_ALLOW_WRITES=true
# Hosts besides localhost that count as test environments, comma-separated.
# QA_TOOLS_ALLOWED_HOSTS=staging.example.test

# Chapter 14: the booking assistant inside the app has its own model settings (falling back to QA_MODEL_*).
# ASSISTANT_MODEL_PROVIDER=anthropic
# ASSISTANT_MODEL=claude-haiku-5-5
# ASSISTANT_MODEL_API_KEY=
# The judge that grades the assistant's answers (falling back to QA_MODEL):
# QA_JUDGE_MODEL=claude-sonnet-5-5
