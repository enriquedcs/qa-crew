{
  "mcpServers": {
    "qa-tools": {
      "command": "npx",
      "args": ["tsx", "src/tools/qa-tools/main.ts"],
      "env": {
        "BOOKING_URL": "${BOOKING_URL:-http://localhost:3000}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--headless", "--isolated"]
    }
  }
}
